# Cloudflare Workers — secrets are set via: wrangler secret put <NAME>
# This file is for documentation only; Workers do not read .env files.

# wrangler secret put JWT_SECRET
JWT_SECRET=your_long_random_secret_here

# wrangler secret put RESEND_API_KEY
# Get from https://resend.com (free tier: 3000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# wrangler secret put ADMIN_EMAIL
ADMIN_EMAIL=pixelpartysrilanka@gmail.com

# wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=your_strong_admin_password_here

# Set in wrangler.toml [vars] — safe to commit (not sensitive)
CORS_ORIGIN=https://pixel-party.pages.dev

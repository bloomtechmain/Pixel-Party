{
  "name": "pixel-party-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "react-snap",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx"
  },
  "reactSnap": {
    "source": "dist",
    "include": ["/", "/contact", "/explore", "/events"],
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox", "--disable-dev-shm-usage"],
    "skipThirdPartyRequests": true,
    "headless": true,
    "viewport": { "width": 1440, "height": 900 },
    "saveAs": "html"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  },
  "allowScripts": {
    "puppeteer@1.20.0": true,
    "esbuild@0.21.5": true
  }
}
